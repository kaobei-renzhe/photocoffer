{
  "name": "lunaris",
  "version": "0.4.0",
  "description": "本地优先的图片素材库：照片、相机与文字都归在这里",
  "main": "./out/main/index.js",
  "author": "silvermoon",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.silvermoon.lunaris",
    "productName": "月相",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "build/icon.png",
      "!**/node_modules/onnxruntime-node/bin/napi-*/darwin/**",
      "!**/node_modules/onnxruntime-node/bin/napi-*/linux/**",
      "!**/node_modules/onnxruntime-node/bin/napi-*/win32/arm64/**",
      "!**/node_modules/onnxruntime-node/bin/napi-*/win32/x64/DirectML.dll",
      "!**/node_modules/onnxruntime-node/bin/napi-*/win32/x64/dxil.dll",
      "!**/node_modules/onnxruntime-node/bin/napi-*/win32/x64/dxcompiler.dll",
      "!**/node_modules/@img/sharp-darwin-*/**",
      "!**/node_modules/@img/sharp-linux-*/**"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.invalid/lunaris"
      }
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/@img/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "files": [
        "out/**/*",
        "package.json",
        "build/icon.png",
        "!**/node_modules/onnxruntime-node/bin/napi-*/darwin/**",
        "!**/node_modules/onnxruntime-node/bin/napi-*/linux/**",
        "!**/node_modules/onnxruntime-node/bin/napi-*/win32/arm64/**",
        "!**/node_modules/onnxruntime-node/bin/napi-*/win32/x64/DirectML.dll",
        "!**/node_modules/onnxruntime-node/bin/napi-*/win32/x64/dxil.dll",
        "!**/node_modules/onnxruntime-node/bin/napi-*/win32/x64/dxcompiler.dll",
        "!**/node_modules/@img/sharp-darwin-*/**",
        "!**/node_modules/@img/sharp-linux-*/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "月相",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.photography",
      "icon": "build/icon.png",
      "identity": null,
      "files": [
        "out/**/*",
        "package.json",
        "build/icon.png",
        "!**/node_modules/onnxruntime-node/bin/napi-*/win32/**",
        "!**/node_modules/onnxruntime-node/bin/napi-*/linux/**",
        "!**/node_modules/@img/sharp-win32-*/**",
        "!**/node_modules/@img/sharp-linux-*/**"
      ]
    },
    "dmg": {
      "title": "${productName} ${version}"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test": "vitest run",
    "bench": "node scripts/bench.mjs",
    "bench:clip": "node scripts/bench-clip.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never --config.electronDist=node_modules/electron/dist && node scripts/clean-release.mjs",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.11",
    "exifr": "^7.1.3",
    "lucide-react": "^1.61.0",
    "onnxruntime-node": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
